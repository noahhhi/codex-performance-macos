#!/bin/zsh
set -eu

dry_run=0
if [[ ${1:-} == --dry-run ]]; then
  dry_run=1
  shift
fi
if (( $# != 0 )); then
  print -u2 "usage: install [--dry-run]"
  exit 64
fi

if [[ $(/usr/bin/uname -s) != Darwin || $(/usr/bin/uname -m) != arm64 ]]; then
  print -u2 "codex-performance-macos supports Apple silicon Macs only."
  exit 69
fi
if [[ $(/usr/bin/id -u) == 0 ]]; then
  print -u2 "Run this installer as your normal login user, not with sudo."
  exit 77
fi
if ! /usr/bin/xcrun --find clang >/dev/null 2>&1; then
  print -u2 "Xcode Command Line Tools are required. Run: xcode-select --install"
  exit 69
fi

script_directory=${0:A:h}
source_directory="${script_directory}/src"
codex_home=${CODEX_HOME:-${HOME}/.codex}
bin_directory="${codex_home}/bin"
shim_directory="${codex_home}/performance-shims"
run_directory="${codex_home}/run"
environment_file="${HOME}/.zshenv"
profile_file="${HOME}/.zprofile"
interactive_file="${HOME}/.zshrc"
target_uid=$(/usr/bin/id -u)
target_user=$(/usr/bin/id -un)
wrapper="${bin_directory}/codex-performance-exec"
launcher="${bin_directory}/codex-performance-exec-bin"
path_begin='# BEGIN codex-performance-macos PATH'
path_end='# END codex-performance-macos PATH'

legacy_daemon_label=local.codex.performance-keeper
legacy_daemon_binary=/Library/PrivilegedHelperTools/local.codex-performance-keeper
legacy_daemon_plist=/Library/LaunchDaemons/local.codex.performance-keeper.plist
older_daemon_label=local.codex.qos-keeper
older_daemon_binary=/Library/PrivilegedHelperTools/local.codex-qos-keeper
older_daemon_plist=/Library/LaunchDaemons/local.codex.qos-keeper.plist
legacy_watcher_label=local.codex.performance-app-watcher
legacy_watcher_plist="${HOME}/Library/LaunchAgents/${legacy_watcher_label}.plist"

temporary_directory=$(/usr/bin/mktemp -d "${TMPDIR:-/tmp}/codex-performance-v2.XXXXXX")
trap '/bin/rm -rf "${temporary_directory}"' EXIT

print "Building the non-root V2 launcher..."
/usr/bin/xcrun clang -O2 -Wall -Wextra -Werror -mmacosx-version-min=11.0 \
  "${source_directory}/codex-performance-exec.c" \
  -o "${temporary_directory}/codex-performance-exec-bin"

render_path_file() {
  local source_file=$1 output_file=$2
  local base_file="${output_file}.base"
  if [[ -f ${source_file} ]]; then
    /usr/bin/awk -v begin="${path_begin}" -v end="${path_end}" '
      $0 == begin { skipping = 1; next }
      $0 == end { skipping = 0; next }
      !skipping { print }
    ' "${source_file}" > "${base_file}"
  else
    : > "${base_file}"
  fi
  {
    /bin/cat "${base_file}"
    [[ ! -s ${base_file} ]] || print
    print -r -- "${path_begin}"
    print -r -- "export PATH=\"${shim_directory}:\$PATH\""
    print -r -- "${path_end}"
  } > "${output_file}"
}
render_path_file "${environment_file}" "${temporary_directory}/zshenv"
render_path_file "${profile_file}" "${temporary_directory}/zprofile"
render_path_file "${interactive_file}" "${temporary_directory}/zshrc"

find_cli_target() {
  local name=$1 fallback=$2 candidate
  local shim_path="${shim_directory}/${name}"
  local -a candidates
  candidates=(${(f)"$(whence -pa "${name}" 2>/dev/null || true)"})
  for candidate in ${candidates[@]}; do
    if [[ ${candidate:A} != ${shim_path:A} && -x ${candidate} ]]; then
      print -r -- "${candidate:A}"
      return 0
    fi
  done
  [[ -x ${fallback} ]] && print -r -- "${fallback:A}"
}

make_cli_shim() {
  local name=$1 target=$2
  local output="${temporary_directory}/${name}"
  {
    print '#!/bin/zsh'
    print -r -- '# Managed by codex-performance-macos V2.'
    print -r -- "exec ${(q)wrapper} ${(q)target} \"\$@\""
  } > "${output}"
  /bin/chmod 0755 "${output}"
}

install_shell_file() {
  local source_file=$1 target_file=$2 mode=0644
  if [[ -e ${target_file} ]]; then
    mode=$(/usr/bin/stat -f '%Lp' "${target_file}")
  fi
  /usr/bin/install -m "${mode}" "${source_file}" "${target_file}"
}

codex_target=$(find_cli_target codex /Applications/ChatGPT.app/Contents/Resources/codex || true)
qoder_target=$(find_cli_target qoder "${HOME}/.qoder/entry/qoder" || true)
[[ -z ${codex_target} ]] || make_cli_shim codex "${codex_target}"
[[ -z ${qoder_target} ]] || make_cli_shim qoder "${qoder_target}"

if (( dry_run )); then
  "${temporary_directory}/codex-performance-exec-bin" --self-test
  "${temporary_directory}/codex-performance-exec-bin" \
    "${temporary_directory}/codex-performance-exec-bin" --probe
  print "Dry run passed: V2 launcher and CLI shims are valid."
  exit 0
fi

/bin/mkdir -p "${bin_directory}" "${shim_directory}" "${run_directory}"
/usr/bin/install -m 0755 "${temporary_directory}/codex-performance-exec-bin" "${launcher}"
/usr/bin/install -m 0755 "${source_directory}/codex-performance-exec" "${wrapper}"
[[ ! -f ${temporary_directory}/codex ]] || /usr/bin/install -m 0755 "${temporary_directory}/codex" "${shim_directory}/codex"
[[ ! -f ${temporary_directory}/qoder ]] || /usr/bin/install -m 0755 "${temporary_directory}/qoder" "${shim_directory}/qoder"
install_shell_file "${temporary_directory}/zshenv" "${environment_file}"
install_shell_file "${temporary_directory}/zprofile" "${profile_file}"
install_shell_file "${temporary_directory}/zshrc" "${interactive_file}"

# Remove all unprivileged V1 components. V2 intentionally has no App watcher,
# open shim, process-registration client, broker, socket, or periodic scanner.
/bin/launchctl bootout "gui/${target_uid}/${legacy_watcher_label}" >/dev/null 2>&1 || true
/usr/bin/pkill -TERM -u "${target_uid}" -f "${bin_directory}/codex-performance-exec-bin --broker" >/dev/null 2>&1 || true
/bin/rm -f \
  "${bin_directory}/codex-performance-register" \
  "${bin_directory}/codex-performance-app-watcher" \
  "${bin_directory}/codex-performance-open" \
  "${shim_directory}/open" \
  "${legacy_watcher_plist}" \
  "${run_directory}/performance-broker.sock" \
  "${run_directory}/performance-broker.sock.lock" \
  "${run_directory}/performance-keeper.sock"

legacy_root_present=0
if [[ -e ${legacy_daemon_binary} || -e ${legacy_daemon_plist} || \
      -e ${older_daemon_binary} || -e ${older_daemon_plist} ]] || \
   /bin/launchctl print "system/${legacy_daemon_label}" >/dev/null 2>&1 || \
   /bin/launchctl print "system/${older_daemon_label}" >/dev/null 2>&1; then
  legacy_root_present=1
fi
if (( legacy_root_present )); then
  print "Administrator authorization removes obsolete V1 privileged components only."
  /usr/bin/sudo /bin/launchctl bootout "system/${legacy_daemon_label}" >/dev/null 2>&1 || true
  /usr/bin/sudo /bin/launchctl bootout "system/${older_daemon_label}" >/dev/null 2>&1 || true
  /usr/bin/sudo /bin/rm -f "${legacy_daemon_binary}" "${legacy_daemon_plist}" \
    "${older_daemon_binary}" "${older_daemon_plist}"
  /usr/bin/sudo -k
fi

print "Verifying V2 installation..."
"${wrapper}" --self-test
if /bin/launchctl print "system/${legacy_daemon_label}" >/dev/null 2>&1 || \
   /bin/launchctl print "gui/${target_uid}/${legacy_watcher_label}" >/dev/null 2>&1; then
  print -u2 "A V1 service is still loaded."
  exit 1
fi
print "Installed V2 for ${target_user}: non-root, direct launch, no daemon or process scanning."
print "Open a new shell for codex/qoder shims. GUI Apps retain normal macOS scheduling."
