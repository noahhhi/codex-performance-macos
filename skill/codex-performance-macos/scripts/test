#!/bin/zsh
set -eu

script_directory=${0:A:h}
source_directory="${script_directory}/src"
temporary_directory=$(/usr/bin/mktemp -d "${TMPDIR:-/tmp}/codex-performance-v2-test.XXXXXX")
trap '/bin/rm -rf "${temporary_directory}"' EXIT

for script in "${script_directory}/install" "${script_directory}/status" \
              "${script_directory}/uninstall" "${source_directory}/codex-performance-exec"; do
  /bin/zsh -n "${script}"
done

/usr/bin/xcrun clang -O2 -Wall -Wextra -Werror -mmacosx-version-min=11.0 \
  "${source_directory}/codex-performance-exec.c" \
  -o "${temporary_directory}/codex-performance-exec-bin"
"${temporary_directory}/codex-performance-exec-bin" --self-test
"${temporary_directory}/codex-performance-exec-bin" \
  "${temporary_directory}/codex-performance-exec-bin" --probe

risky_pattern='PRIO_DARWIN_ROLE|proc_listpids|proc_pidinfo|EVFILT_PROC|NOTE_(FORK|EXEC|EXIT)|posix_spawnattr_set_darwin_role|posix_spawnattr_setprocesstype|setpriority|performance-keeper[.]sock|--broker'
if /usr/bin/grep -E "${risky_pattern}" "${source_directory}/codex-performance-exec.c"; then
  print -u2 "Crash-prone V1 process-management API detected."
  exit 1
fi

for removed_source in codex-performance-app-watcher.m codex-performance-open.m \
                      codex-performance-register.c codex-qos-keeper.c \
                      performance-client.c performance-client.h performance-protocol.h; do
  if [[ -e ${source_directory}/${removed_source} ]]; then
    print -u2 "Obsolete V1 source is still present: ${removed_source}"
    exit 1
  fi
done

personal_uid_pattern='uid_t target_uid = 5''01'
if /usr/bin/grep -R --exclude=test -E "/Users/|${personal_uid_pattern}|BEGIN (RSA|OPENSSH|EC) PRIVATE KEY" \
     "${script_directory:h}"; then
  print -u2 "Sensitive or machine-specific content detected."
  exit 1
fi

"${script_directory}/install" --dry-run
print "V2 build, direct-exec, shell, API-boundary, and privacy checks passed."
