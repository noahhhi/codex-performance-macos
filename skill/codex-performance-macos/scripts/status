#!/bin/zsh
set -u

codex_home=${CODEX_HOME:-${HOME}/.codex}
wrapper="${codex_home}/bin/codex-performance-exec"
shim_directory="${codex_home}/performance-shims"
legacy_daemon_label=local.codex.performance-keeper
legacy_daemon_binary=/Library/PrivilegedHelperTools/local.codex-performance-keeper
legacy_daemon_plist=/Library/LaunchDaemons/local.codex.performance-keeper.plist
older_daemon_binary=/Library/PrivilegedHelperTools/local.codex-qos-keeper
older_daemon_plist=/Library/LaunchDaemons/local.codex.qos-keeper.plist
legacy_watcher_label=local.codex.performance-app-watcher
legacy_watcher_plist="${HOME}/Library/LaunchAgents/${legacy_watcher_label}.plist"
failed=0

print "Architecture: $(/usr/bin/uname -m)"
if [[ -x ${wrapper} ]] && "${wrapper}" --self-test; then
  print "Launcher: V2 direct mode"
else
  print -u2 "V2 launcher is missing or failed self-test: ${wrapper}"
  failed=1
fi

if [[ -e ${legacy_daemon_binary} || -e ${legacy_daemon_plist} || \
      -e ${older_daemon_binary} || -e ${older_daemon_plist} ]] || \
   /bin/launchctl print "system/${legacy_daemon_label}" >/dev/null 2>&1; then
  print -u2 "Legacy Keeper is still loaded (${legacy_daemon_label})."
  failed=1
else
  print "Privileged Keeper: absent"
fi
if [[ -e ${legacy_watcher_plist} || \
      -e ${codex_home}/bin/codex-performance-app-watcher ]] || \
   /bin/launchctl print "gui/$(/usr/bin/id -u)/${legacy_watcher_label}" >/dev/null 2>&1; then
  print -u2 "Legacy App watcher is still loaded (${legacy_watcher_label})."
  failed=1
else
  print "App watcher: absent"
fi

for shim in codex qoder; do
  if [[ -x ${shim_directory}/${shim} ]]; then
    print "CLI shim: ${shim}"
    resolved=$(/bin/zsh -lic "whence -p ${(q)shim}" 2>/dev/null | /usr/bin/head -n 1)
    if [[ ${resolved:A} != ${shim_directory}/${shim} ]]; then
      print -u2 "A new interactive shell does not select the ${shim} shim (found: ${resolved:-missing})."
      failed=1
    fi
  fi
done
if [[ -e ${shim_directory}/open ]]; then
  print -u2 "Legacy open shim is still installed."
  failed=1
else
  print "GUI launch interception: disabled"
fi

print "Process scanning: disabled"
print "Private Darwin role changes: disabled"
exit ${failed}
